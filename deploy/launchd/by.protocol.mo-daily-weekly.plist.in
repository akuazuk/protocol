<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>by.protocol.mo-daily-weekly</string>
  <key>ProgramArguments</key>
  <array><string>__WRAPPER__</string><string>weekly</string></array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict><key>MO_PYTHON</key><string>__PYTHON__</string></dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>11</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>__LOG_DIR__/mo-daily-weekly.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/mo-daily-weekly.error.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
