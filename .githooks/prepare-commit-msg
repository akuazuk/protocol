#!/usr/bin/env bash
# Вычищает из сообщения коммита vendor/AI-приписки.
#
# Правило: .cursor/rules/no-ai-vendor-attribution.mdc - в коммитах, PR, коде и
# docs не должно быть трейлеров `Co-authored-by:` от IDE и агентов, а также
# пометок «Made with …» / «Generated by …». Сообщение коммита - только суть.
#
# Почему хук лежит здесь, а не в .git/hooks: файлы в .git не версионируются,
# поэтому на другой машине или в новом worktree их просто нет - именно так
# приписки и попали в историю этой ветки. Каталог .githooks/ отслеживается
# git, и подключается один раз:
#
#   git config core.hooksPath .githooks
#
# Установка для всех worktree сразу: scripts/ops/install_git_hooks.sh
set -euo pipefail

MSG_FILE="${1:?prepare-commit-msg: не передан путь к файлу сообщения}"
[[ -f "$MSG_FILE" ]] || exit 0

# Удаляются:
#   - Co-authored-by с адресами ассистентов (cursoragent, noreply@anthropic и пр.);
#   - строки Generated with / Made with / Generated by, если в них бренд ассистента.
# Обычные Co-authored-by с человеческими адресами НЕ трогаем: соавторство
# людей - легитимная информация.
python3 - "$MSG_FILE" <<'PY'
import re
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as fh:
    lines = fh.readlines()

# Признаки машинного соавторства: домены и имена ассистентов.
vendor = re.compile(
    r"(cursoragent|cursor\.com|noreply@anthropic|claude|copilot|codeium|"
    r"devin|openai\.com|chatgpt)",
    re.IGNORECASE,
)
generated = re.compile(
    r"^\s*(?:[#>*-]\s*)?(?:🤖\s*)?(?:generated (?:with|by)|made with|"
    r"co-authored-by:\s*(?:cursor|claude|copilot|codex))\b",
    re.IGNORECASE,
)

out = []
for line in lines:
    stripped = line.strip()
    if stripped.lower().startswith("co-authored-by:") and vendor.search(stripped):
        continue
    if generated.match(stripped) and vendor.search(stripped):
        continue
    if generated.match(stripped) and "co-authored-by" in stripped.lower():
        continue
    out.append(line)

# Не оставляем хвост из пустых строк после удаления трейлеров.
while out and not out[-1].strip():
    out.pop()
if out:
    out[-1] = out[-1].rstrip("\n") + "\n"

if out != lines:
    with open(path, "w", encoding="utf-8") as fh:
        fh.writelines(out)
PY
