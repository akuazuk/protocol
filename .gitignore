__pycache__/
*.pyc
*.part
.venv/
.env
.env.local
.cursor/render-watch-state.json
.cursor/render-watch.log

# Выход corpus_pipeline: полные чанки/документы/таблицы > лимита GitHub — генерировать локально
output/chunks/
output/documents/
output/tables/
output/consult_archive/

# Локальный эталон дымового теста RAG (генерируется scripts/rag_smoke.py --write-baseline)
scripts/rag_smoke_baseline.json

# Локальные golden-запросы под полный корпус (копия из .prod.example)
eval/golden_queries.prod.jsonl

# Локальные таблицы (часто большие); при необходимости закоммить вручную
/МКБ-10.xlsx

# Консультативные заключения пациентов (ПДн) — никогда не коммитить
clients_consult/*
!clients_consult/README.md
data/KZ/

# Выгрузка mis_protocol (ПДн пациентов) — только локально
data/mis_protocol/*.parquet
data/mis_protocol/*.csv
data/mis_protocol/*_cases.jsonl
data/mis_protocol/*_state.jsonl
!data/mis_protocol/README.md
!data/mis_protocol/*.meta.json
!data/mis_protocol/*_summary.json
!data/mis_protocol/*_llm_queue.json
data/mis_protocol/*_gemini_reviews.json
data/mis_protocol/*.log

# Ежедневный МО-pipeline: raw/ПДн, state, warehouse, reports и runtime public snapshots.
# Публикация обезличенных агрегатов выполняется отдельным разрешённым каналом, не через git.
data/medical_exams/

# Мировые базы ЛС: сырьё/большие индексы регенерируются скриптами (fetch_*/build_*),
# рукотворные seed'ы (high_alert, stopp_start_beers) — коммитим.
data/drug_safety/ddinter/
data/drug_safety/ddinter_pairs.json
data/drug_safety/rxnorm_cache.json
!data/drug_safety/high_alert.json
!data/drug_safety/stopp_start_beers.json

# ML feedback: тексты КЗ и снимки прогонов (on-prem, ПДн)
data/ml/secure/
data/ml/analyses/
data/ml/feedback/*.jsonl

# Deep-eval датасет КЗ (ПДн: cases с patient_id/ФИО; регенерируется --deep-only).
# Агрегатные summary/отчёты без ПДн можно коммитить точечно.
data/ml/reports/deep_eval/*_cases.jsonl
data/ml/reports/deep_eval/*_state.jsonl
data/ml/reports/deep_eval/*_llm_queue.json
# Gold-манифест содержит visit_id (ПДн-смежное) — в git только strata_summary*.md (§9).
data/ml/kz_gold/*.jsonl

# ML чекпоинты (тяжёлые); отчёты ml/experiments/*/REPORT.md коммитятся
