# Скопируйте в .env и заполните (файл .env в git не коммитится)
GOOGLE_API_KEY=

# --- Безопасность (Фаза 1) ---
# CORS: список разрешённых origin через запятую. Пусто = только same-origin (фронтенд на том же домене работает).
# Для открытого доступа из других доменов укажите список или "*".
# ALLOWED_ORIGINS=https://app.example.by,https://admin.example.by
# Rate-limiting (запросов в минуту на IP). 0 - без лимита по конкретному маршруту.
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_ASSIST_PER_MIN=20
# RATE_LIMIT_CONSULT_PER_MIN=6
# RATE_LIMIT_PRACTICAL_PER_MIN=15
# RATE_LIMIT_DETAIL_PER_MIN=30
# RATE_LIMIT_TEMPLATE_PER_MIN=20
# RATE_LIMIT_ICD_PER_MIN=40
# RATE_LIMIT_VERIFY_PER_MIN=3
# RATE_LIMIT_DEFAULT_PER_MIN=60
# Кэш ответа /api/verify-key (сек) - не тратить квоту на частые проверки.
# VERIFY_KEY_CACHE_TTL=300
# Если задан - /api/verify-key требует заголовок X-Admin-Token со значением токена.
# API_ADMIN_TOKEN=
# Content-Security-Policy: задайте свою строку или включите дефолтную (может потребовать настройки под CDN).
# ENABLE_DEFAULT_CSP=0
# CONTENT_SECURITY_POLICY=
# DEBUG_ERRORS=0  # 1 - отдавать детальный текст внутренней ошибки в /health и /api/corpus-stats

# Render.com (в панели сервиса → Environment, не в git):
# PYTHON_VERSION=3.11.8
# GOOGLE_API_KEY=...

# Опционально:
# GEMINI_API_KEY=
# GEMINI_MODEL=...                    # имя модели на сервере (см. документацию поставщика API)
# GEMINI_METHODIST_MODEL=gemini-2.5-pro  # этап 2 кабинета методиста (не gemini-3.1-pro - такой модели нет в API)
# METHODIST_AI_REVIEW=1               # AI-оценка после L1/L2 (по умолчанию включена)
# Детерминированность ответа (воспроизводимость оценки при одинаковом входе):
# по умолчанию temperature=0 (жадное декодирование) и candidate_count=1 - один и тот же PDF даёт один результат.
# GEMINI_TEMPERATURE=0.0    # >0 - вернуть вариативность (НЕ рекомендуется для воспроизводимой оценки)
# GEMINI_TOP_P=             # задать, если нужно ограничить ядро выборки (обычно не требуется при temp=0)
# GEMINI_TOP_K=             # задать, если нужно ограничить top-k
# GEMINI_SEED=              # фиксированный seed (если поддерживается версией SDK) - доп. стабилизация
# GEMINI_CALL_TIMEOUT=240
# GEMINI_MAX_OUTPUT_TOKENS=16384
# GEMINI_JSON_MODE=1
# GEMINI_ASSIST_RETRY=1
# Повтор при 429/quota (Фаза 2): число повторов и базовая задержка (сек), backoff растёт линейно.
# GEMINI_QUOTA_RETRY=2
# GEMINI_QUOTA_RETRY_DELAY=2.0
# RAG_ROUTING=1
# RAG_AUDIENCE_FILTER=1
# RAG_MAX_CHUNKS=6
# RAG_EXCERPT_CHARS=700
# GEMINI_PROMPT_MAX_CHARS=28000
# GEMINI_SPECIALTY_CLASSIFY=0   # 1 - доп. вызов модели: к каким рубрикам относится запрос (усиливает отбор)
# GEMINI_EXTRACT_FULL_MATCH=1   # развёрнутая выдержка: при 100% - сразу в /api/assist; при 80-99% - кнопка → POST /api/protocol-detail
# RAG_ASSIST_INLINE_DETAIL=0    # 0 (по умолчанию) - быстрый /api/assist без 2-го вызова модели; 1 - сразу развёрнутая выдержка
# RAG_EXTRACT_MAX_CHARS=16000
# RAG_CATEGORY_BOOST_FACTOR=1.45
# RAG_CHUNKS_SOURCE=          # пусто - авто: corpus_chunks_parts/*.jsonl если есть, иначе chunks.json
# RAG_CHUNKS_SOURCE=json      # принудительно старый build_chunks.py (chunks.json)
# Каталог с JSONL (на Render: Persistent Disk, см. render.yaml). Глобы ниже - относительно него.
# RAG_CHUNKS_DIR=/var/data
# RAG_CHUNKS_JSONL=           # один файл JSONL (абсолютный путь или относительный)
# RAG_CHUNKS_JSONL_GLOB=      # glob относительно RAG_CHUNKS_DIR (или корня проекта, если RAG_CHUNKS_DIR не задан)
# RAG_USER_CATEGORY_BOOST=2.05   # множитель релевантности, если чанк в выбранной пользователем рубрике
# RAG_USER_CATEGORY_PENALTY=0.32 # ослабление, если рубрика чанка не среди выбранных
# RAG_USER_CATEGORY_UNCERTAIN=0.78 # при отсутствии рубрики у чанка
# RAG_EXTRACT_FULL_MATCH_MAX_CHARS=32000  # объём текста протокола при извлечении при 100% соответствии
# RAG_DETAIL_EXTRACT_MIN_SCORE=0.8  # порог (0-1) для развёрнутой выдержки; по умолчанию 0.8 = 80%
# Развёрнутая выдержка по протоколу (extract_clinical_detail)
# RAG_EXTRACT_PROMPT_MAX_CHARS=    # пусто = как GEMINI_PROMPT_MAX_CHARS; иначе лимит промпта для извлечения
# RAG_EXTRACT_ITEM_MAX_CHARS=420    # обрезка одного пункта в списках investigations/medications/treatment_methods
# RAG_EXTRACT_GAP_RETRY=1
# RAG_EXTRACT_NON_PROTOCOL_FALLBACK=1
# RAG_EXTRACT_NON_PROTOCOL_MONITORING_ONLY=0  # 1 - общеклинический fallback только для кратности наблюдения
# RAG_DETAIL_WARN_RAG_SUPPORT=0.22  # ниже - предупреждение «слабый отбор» при переданном client_rag_support
# RAG_SPELLFIX_ON_EMPTY=1          # при пустом лексическом отборе - исправить опечатки моделью и повторить поиск
# RAG_GEMINI_QUERY_REFINE=1        # перед поиском - уточнить жалобу через модель (терминология МКБ/протоколы)
# RAG_QUERY_REFINE_TIMEOUT=45      # таймаут вызова (сек.) для уточнения жалобы
# GEMINI_SPELLFIX_TIMEOUT=45       # таймаут короткого вызова исправления (с)
# RAG_MEMORY_SAVER=          # 1 - экономия RAM (без дубля embedding_ready_text); по умолчанию выкл. - полный lex
# RAG_KEEP_STRUCT=1          # сохранять структуру чанка (раздел/страницы/пункты/МКБ) для точных ссылок; 0 - как раньше
# RAG_LEXICAL_MAX_CHARS=0    # если >0 - обрезать lex_text для поиска (ещё ниже RAM)
#
# Гибридный отбор: лексика + BM25 + семантическое переранжирование пула (embedding)
# RAG_LEX_BM25_ALPHA=0.55          # 1.0 - только лексика без BM25
# RAG_LEX_INVERTED_INDEX=1         # 0 - полный проход по всем чанкам (медленнее на большом корпусе)
# RAG_PRECOMPUTED_CHUNK_EMBED=0    # 1 - rerank по полю embedding в JSONL (query embed через API)
# Офлайн: python3 scripts/build_chunk_embeddings.py → python3 scripts/build_vector_index.py
# RAG_VECTOR_INDEX=0               # 1 - FAISS/numpy prefilter top-K перед lex/BM25
# RAG_VECTOR_TOP_K=200
# RAG_VECTOR_INDEX_PATH=           # каталог индекса (по умолчанию corpus_vector_index)
# RAG_BM25_K1=1.5
# RAG_BM25_B=0.75
# RAG_EMBED_POOL_MERGE=1           # объединить топ по score и топ по BM25 перед эмбеддингом
# RAG_GEMINI_EMBED_RERANK=1
# GEMINI_EMBEDDING_MODEL=...       # модель эмбеддингов для rerank (см. конфигурацию сервера)
# RAG_EMBED_POOL=44            # по умолчанию в коде; больше - шире пул перед embed-rerank (дороже по API)
# RAG_HYBRID_ALPHA=0.46
#
# Согласование оценки модели с отбором фрагментов (rag_support)
# RAG_LLM_CONF_BLEND_W=0.62
# RAG_MIN_RAG_SUPPORT_CAP=0.74
# RAG_MIN_RAG_SUPPORT_FOR_HIGH_CONF=0.2
# RAG_DETAIL_MIN_RAG_SUPPORT=0.12  # порог rag_support для авторазвёрнутой выдержки
# RAG_ICD_META_BOOST=1.35          # если в protocol_meta заданы icd_codes и пересечение с запросом
# RAG_ICD_QUERY_MISS_CHUNK_MULT=0.62  # при непустом codes_for_retrieval: ослабить чанк, если в его тексте нет ни одного из кодов запроса (подстрока)
#
# RAG_CHUNK_VOTE_RERETRIEVE=0      # 1 - второй retrieve с рубрикой по голосу чанков (дольше)
# RAG_CONFIDENCE_SECOND_PASS=0     # 1 - короткий второй вызов модели для калибровки %
# RAG_CONFIDENCE_SECOND_BLEND=0.55
#
# МКБ-10: JSON из Excel (см. data/icd_reference/README.md и scripts/export_icd_ru_from_xlsx.py)
# ICD_RU_XLSX=data/icd_reference/mkb10_minzdrav_rb.xlsx
# ICD_RU_JSON=data/icd_reference/icd10_ru_mkb10su.json
#
# Подбор кодов через модель только из лексического пула; эмбеддинги по кодам отключены по умолчанию.
# RAG_ICD_GEMINI_SELECT=1
# RAG_ICD_GEMINI_MIN_TOP_SCORE=0.8   # верхний score отбора протокола (0-1) после эмбеддинг-переранжирования
# RAG_ICD_GEMINI_REQUIRE_EMBED_RANK=1  # 0 - разрешить подбор без гибридного score (не рекомендуется)
# RAG_ICD_LEX_TOP=12
# RAG_ICD_EMBED_POOL=32
# RAG_ICD_EMBED_K=0                  # 0 - не добавлять кандидатов МКБ через эмбеддинг (только лексикон)
# RAG_ICD_EMBED_RANK=1               # при RAG_ICD_EMBED_K>0 - ранжировать пул эмбеддингом
# GEMINI_EMBED_CALL_TIMEOUT=45
# GEMINI_TEMPLATE_MAX_TOKENS=8192
# GEMINI_TEMPLATE_DRAFT_MAX_CHARS=100000
# GEMINI_TEMPLATE_PROMPT_MAX_CHARS=28000

# --- Проверка консультативного заключения (POST /api/consult-review[/stream], consult_review.html)
# CONSULT_REVIEW_MAX_FILES=3
# CONSULT_REVIEW_MAX_MB=15
# CONSULT_REVIEW_MAX_PAGES=200            # лимит страниц PDF при извлечении текста (0 - без лимита)
# Кэш результата по контент-хэшу файлов: один и тот же PDF -> идентичный результат (воспроизводимость).
# CONSULT_REVIEW_CACHE=1                   # 0 - отключить кэш (каждый запрос считается заново)
# CONSULT_REVIEW_CACHE_MAX=256            # максимум записей в кэше (вытеснение самых старых)
# Итоговый % как среднее баллов критериев (прозрачно и воспроизводимо); 0 - оставить число модели.
# CONSULT_REVIEW_OVERALL_FROM_CRITERIA=1
# Обогащённый контекст для модели: добавлять раздел/страницы/пункты к выдержкам протоколов (точнее ссылки).
# CONSULT_REVIEW_RICH_CONTEXT=1            # 0 - старый формат контекста (path + type), для сравнения/отката
# CONSULT_REVIEW_MAX_TEXT_CHARS=120000
# CONSULT_REVIEW_RAG_QUERY_CHARS=9000
# CONSULT_REVIEW_PROTOCOL_CTX_CHARS=16500
# CONSULT_REVIEW_CONSULT_CHARS=20000
# CONSULT_REVIEW_STRICT_PROTOCOLS=1        # RAG только по PDF, сопоставленным с МКБ/правилами (рекомендуется)
# CONSULT_REVIEW_MAX_PROTOCOL_PATHS=6      # макс. целевых PDF для анализа КЗ
# GEMINI_CONSULT_REVIEW_SYNTH_TIMEOUT=120  # таймаут финальной оценки модели (сек)
# GEMINI_CONSULT_REVIEW_MAX_TOKENS=16384   # лимит токенов JSON-ответа финальной оценки
# CONSULT_REVIEW_SYNTH_RETRY=1             # повтор синтеза с x2 лимитом токенов при обрезанном JSON
# CONSULT_STRUCTURED_ANALYSIS=1            # детерминированный структурный разбор КЗ (поле structured_analysis в ответе)
# CONSULT_ARCHIVE_ANALYSES=0            # опционально на Render: manifest.jsonl на диске (без UI)
# CONSULT_ARCHIVE_DIR=./output/consult_archive
# Регрессия в Cursor: tests/fixtures/consult_replay.jsonl в git → git pull → replay_consult_archive.py
# С Render: CONSULT_ARCHIVE_ANALYSES=1, затем scripts/sync_consult_fixtures.py → git push
# CONSULT_REVIEW_MAX_CHUNKS=12
# CONSULT_REVIEW_MAX_PER_PATH=3
# COMPLIANCE_GATE_MODE=soft_gate             # inform | soft_gate (по умолчанию) | hard_gate | critical_only
# COMPLIANCE_GATE_MIN_SCORE=70               # порог «доработать» / override / блок (hard_gate)
# COMPLIANCE_GATE_SOFT_MIN_SCORE=55          # уровень риска medium ниже этого балла

# CONSULT_REVIEW_TIER=L2                     # L0|L1|L2 по умолчанию для /api/consult-review/json
# RULE_SEMANTIC_FALLBACK=1                   # фаза 3: алиасы/токены после substring для required_exam
# RULE_SEMANTIC_EMBED=0                      # 1 - опциональный embed-fallback для правил (дороже)
# RULE_SEMANTIC_EMBED_THRESHOLD=0.82
# CORPUS_LLM_ENRICH=0                        # фаза 5: LLM-enrichment правил (scripts/enrich_protocol_rules_batch.py)
# CONSULT_REVIEW_FAST=1                      # быстрый разбор: меньше Gemini, без embed-rerank (на Render вкл. по умолчанию)
# CONSULT_REVIEW_PROFILE=fast|full           # профиль скорости/качества (full - все LLM-шаги)
# CONSULT_REVIEW_HEURISTIC_DIGEST_FIRST=1    # 1 - не звать Gemini-digest, если эвристика уже нашла ядро КЗ
# CONSULT_REVIEW_EMBED_RERANK=0              # 0 - только лексический RAG (быстрее; в fast по умолчанию выкл)
# CONSULT_REVIEW_CLIENT_TIMEOUT_SEC=600      # таймаут ожидания в UI (сек)
# CONSULT_REVIEW_DIGEST_INPUT_CHARS=14000
# CONSULT_REVIEW_DIGEST_PROMPT_CHARS=12000
# CONSULT_REVIEW_DIGEST_MIN_CHARS=100
# CONSULT_REVIEW_DIGEST_MAX_CHARS=2000
# CONSULT_REVIEW_ICD_MERGE_CAP=12         # коды из PDF объединяются с МКБ из разбора для лекс-сигнала
# GEMINI_CONSULT_DIGEST_TIMEOUT=55
# Консультативное заключение: онко-контекст - сильные маркеры сразу, слабые только при сумме ≥ N
# CONSULT_REVIEW_ONCOLOGY_WEAK_MIN_HITS=2
# kz_only (default) - онко-баннер только по тексту КЗ; legacy - также рубрика novoobrazovaniya в каталоге
# CONSULT_ONCO_SCAN_SOURCE=kz_only
# При rules_compliance_pct=0 подтянуть правила из Protocol Summary Cards по МКБ
# CONSULT_RULES_SUMMARY_FALLBACK=1
# CONSULT_PREWARM_SUMMARY_ICD_INDEX=1
# CONSULT_RULES_SUMMARY_FALLBACK_MAX_SUMMARIES=2
# CONSULT_RULES_SUMMARY_FALLBACK_MAX_RULES=48

# --- Вторая проходка retrieve при «низкой уверенности» первого отбора (/api/consult-review)
# CONSULT_REVIEW_RAG_SECOND_PASS=1                   # 0 - отключить; на Render по умолчанию выкл (RENDER=true), если переменная не задана
# CONSULT_REVIEW_RAG_LOW_MAX_SCORE=0.32               # ниже этого max_score среди чанков 1-й проходки - триггер
# CONSULT_REVIEW_RAG_LOW_LEX_AVG=0                    # если >0: также триггер при низком среднем топ-3 lexical_score
# CONSULT_REVIEW_RAG_SECOND_PASS_MIN_UNIQUE_PATHS=3   # триггер, если uniq path после 1-й проходки меньше этого
# CONSULT_REVIEW_RAG_SECOND_PASS_GEMINI=1             # черновое уточнение запроса моделью; 0 - доп. только названия КП
# CONSULT_REVIEW_RAG_SECOND_PASS_EXTRA_CHUNKS=4      # второй retrieve: около MAX_CHUNKS + это
# CONSULT_REVIEW_RAG_SECOND_PASS_CANDIDATES=8        # кандидаты в промпте черновика
# CONSULT_REVIEW_RAG_SECOND_PASS_MAX_CHARS=2200      # ограничение строки refined_search_text
# GEMINI_CONSULT_RAG_REFINE_TIMEOUT=42

# --- Observability и версия сборки ---
# REQUEST_LOG=1            # логировать запросы /api/* и ошибки (метод, путь, статус, время)
# SLOW_REQUEST_MS=8000     # запрос дольше этого порога логируется уровнем WARNING
# LOG_LEVEL=INFO           # уровень логгера protocol.rag (DEBUG/INFO/WARNING)
# APP_VERSION=dev          # версия сборки в /health, /api/corpus-stats, /api/version

# --- Кабинет методиста (Methodist Workbench, фаза A) ---
# RAG_ICD_FAST_AUTO=1                 # при МКБ в запросе — сначала lookup каталога (мс), без RAG
# RAG_SEARCH_SKIP_LLM_ON_RETRIEVE_ONLY=1  # retrieve_only: без Gemini refine/ICD/specialty
# METHODIST_PIN=            # альтернатива METHODIST_TOKEN (6 цифр)
# METHODIST_REVIEWER=И.О.    # инициалы методиста (подпись в feedback)
# METHODIST_UI_AUTO_LOGIN=1  # on-prem: автовход на /?mode=methodist без формы (токен+инициалы из env)
# ML_FEEDBACK_DIR=data/ml/feedback
# Render: задавайте /var/data/ml/feedback только после Persistent Disk (mount /var/data).
# Без диска переменную лучше не задавать — приложение пишет в data/ml/feedback (эфемерно).
