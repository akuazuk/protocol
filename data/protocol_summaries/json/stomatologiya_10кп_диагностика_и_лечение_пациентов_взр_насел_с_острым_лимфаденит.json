      "treatment": {
        "non_drug": [
          {
            "text": "Для антисептической обработки ран наносят на пораженную поверхность кожи или слизистых оболочек 5–10 мл раствора с экспозицией 1–3 мин 2–3 раза в сутки (на тампоне или путем орошения).",
            "source_ref": {
              "protocol_id": "stomatologiya_10кп_диагностика_и_лечение_пациентов_взр_насел_с_острым_лимфаденит",
              "document_url": null,
